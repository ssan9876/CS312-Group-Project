<!--The header for the profile page-->
<%- include('partials/header') %>
<!-- User profile page: data supplied by routes/profile.js -->
<div class="profile-page">
  <section class="profile-summary" aria-label="User information">
    <div class="profile-picture-container">
      <div class="recipe-photo profile-photo">Profile Picture</div>
    </div>
    <!--The profile information section for username, names, ratings, recipes, and bios-->
    <div class="profile-information">
      <!--The user name-->
      <h1 class="profile-username"><%= profile.username %></h1>
      <!--The full name-->
      <p class="profile-fullname"><%= profile.firstName %> <%= profile.lastName %></p>
      <!--The ratings, might change if not seen to be needed-->
      <p class="profile-rating"><strong>Rating:</strong> <span class="rating-placeholder">Not yet available</span></p>
      <!--The amount of recipes they have-->
      <p class="profile-recipe-count"><strong>Recipes Uploaded:</strong> <%= recipes.length %></p>
      <!--The bio for the user-->
      <div class="profile-bio">
        <h2>Bio</h2>
        <!--The else if the user didn't add a bio-->
        <p><%= profile.bio || 'This user has not added a bio yet.' %></p>
      </div>
    </div>
  </section>
  <!--The columns for holding the recipe the user made -->
  <div class="profile-columns">
    <section class="profile-recipes-section" aria-labelledby="profile-recipes-title">
      <h2 id="profile-recipes-title" class="profile-section-title">Recipes</h2>
      <div class="profile-recipe-list">
        <% if (recipes.length > 0) { %>
          <% recipes.forEach((recipe) => { %>
            <%- include('partials/recipe-card', { recipe }) %>
          <% }) %>
          <!--This is the else, if the user hasn't made any recipes yet-->
        <% } else { %>
          <p class="profile-empty-message">This user has not uploaded any recipes yet.</p>
        <% } %>
      </div>
    </section>
<!--The columns for the reviews that the user has made-->
    <section class="profile-reviews-section" aria-labelledby="profile-reviews-title">
      <h2 id="profile-reviews-title" class="profile-section-title">Reviews</h2>
      <div class="profile-review-list">
        <% if (comments.length > 0) { %>
          <% comments.forEach((comment) => { %>
            <article class="profile-review-card">
              <h3 class="review-username"><%= profile.username %></h3>
              <p class="review-recipe-title">
                <strong>Recipe:</strong>
                <a href="/recipes/<%= comment.recipeId %>"><%= comment.recipeTitle %></a>
              </p>
              <p class="review-content"><%= comment.body %></p>
            </article>
          <% }) %>
          <!--The else if the user hasn't made any reviews yet-->
        <% } else { %>
          <p class="profile-empty-message">This user has not written any reviews yet.</p>
        <% } %>
      </div>
    </section>
  </div>
</div>

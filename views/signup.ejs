<%- include('partials/header') %>
<%# TODO(Dwayne, Phase 1): signup page layout. Open question: which fields do we keep? %>
<form class="form-box" action="/signup" method="post">
  <h1>Sign up</h1>
  <%- include('partials/form-errors') %>
  <label>Email <input type="email" name="email" value="<%= locals.values?.email || '' %>" autocomplete="email" required></label>
  <label>Username <input name="username" value="<%= locals.values?.username || '' %>" autocomplete="username" pattern="[A-Za-z0-9_]{3,30}" maxlength="30" title="3-30 letters, numbers, or underscores" required></label>
  <label>First name <input name="firstName" value="<%= locals.values?.firstName || '' %>" autocomplete="given-name" required></label>
  <label>Last name <input name="lastName" value="<%= locals.values?.lastName || '' %>" autocomplete="family-name" required></label>
  <label>Password <input type="password" name="password" autocomplete="new-password" minlength="8" maxlength="72" required></label>
  <label>Confirm password <input type="password" name="confirmPassword" autocomplete="new-password" required></label>
  <button type="submit">Sign up</button>
  <p>Already have an account? <a href="/login">Log in</a></p>
</form>
<%- include('partials/footer') %>
